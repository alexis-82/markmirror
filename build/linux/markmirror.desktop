[Desktop Entry]
Type=Application
Name=MarkMirror
GenericName=Markdown Editor
GenericName[it]=Editor Markdown
Comment=Markdown editor with live preview
Comment[it]=Editor Markdown con anteprima in tempo reale
Exec=/usr/local/bin/markmirror-launch.sh %f
Icon=markmirror
Terminal=false
Categories=Office;TextEditor;Utility;
